# Backend: copy to apps/api/.env; never commit actual credentials.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
ADMIN_ORIGIN=http://localhost:3001
# Generate with cryptography.fernet.Fernet.generate_key(); backend only.
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/gmail/callback
# Web: copy these entries to apps/web/.env.local
API_URL=http://127.0.0.1:8000
PORTAL_MODE=client
PUBLIC_ORIGIN=http://localhost:3000
